generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PowerBILink {
  id          String   @id @default(cuid())
  title       String
  url         String
  category    String   @default("General")
  description String?
  isActive    Boolean  @default(false)
  order       Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  targetType  String   @default("link")
  targetId    String?
  targetTitle String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}